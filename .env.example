# Proveedor fake por defecto: no hace falta ninguna clave.
LLM_PROVIDER=fake
EMBEDDING_PROVIDER=fake

# Para Gemini:
# LLM_PROVIDER=gemini
# EMBEDDING_PROVIDER=gemini
# GEMINI_API_KEY=pega-la-clave-aqui
# LLM_MODEL=gemini/gemini-2.0-flash
# EMBEDDING_MODEL=gemini/text-embedding-004

# Para OpenAI:
# LLM_PROVIDER=openai
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=pega-la-clave-aqui
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# Groq solo cubre el LLM. No tiene embeddings de 384 dimensiones:
# deja EMBEDDING_PROVIDER=fake (la búsqueda léxica sigue activa).
# LLM_PROVIDER=groq
# EMBEDDING_PROVIDER=fake
# GROQ_API_KEY=pega-la-clave-aqui
# LLM_MODEL=groq/openai/gpt-oss-120b

LLM_TIMEOUT_SECONDS=30
